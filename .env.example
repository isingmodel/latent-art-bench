# Optional local configuration. Current numeric/plot replay needs no credentials.
# Copy to .env only when a separately authorized task needs transport access.
# Never commit .env or real values. Completed collectors must not be restarted.

# Retained OpenRouter discovery/transport code reads this key from .env.
OPENROUTER_API_KEY=

# Legacy shared configuration supports this endpoint environment override.
LATENT_ART_IMAGE_BASE_URL=http://127.0.0.1:10531/v1

# Historical metadata-route credentials; a new census requires its own scope.
EUROPEANA_API_KEY=
PARIS_MUSEES_API_TOKEN=
