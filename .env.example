# Illustrative only; this file is not loaded automatically and authorizes nothing.
# `latent_art_bench.config` still reads this variable, but the active study is at stage R0
# (metadata census) and registers no generation transport.
LATENT_ART_IMAGE_BASE_URL=http://127.0.0.1:10531/v1

# Two Protocol 2.1 source routes need credentials that the repository does not hold. Setting
# them here is not authorization to run a census; each route still needs its reviewed freeze.
# Without them the routes are recorded as not_executed_missing_authorized_credential.
EUROPEANA_API_KEY=
PARIS_MUSEES_API_TOKEN=
