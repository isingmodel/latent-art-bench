# Local state, credentials and build output
.env
.env.*
!.env.example
*.pem
*.key
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/
tmp/

# Unique local research media, weights and source checkouts stay out of Git.
artifacts/
outputs/
research_workspace/

# Compact evidence is JSON/JSONL under data/manifests; raw bytes stay ignored.
/data/*
!/data/manifests/
/data/manifests/**
!/data/manifests/**/
!/data/manifests/**/*.json
!/data/manifests/**/*.jsonl

# Images and PDFs are excluded except the paper and published numeric plots.
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.webp
!/paper/paper.pdf
!/paper/figures/*.pdf
!/reports/**/plots/*.png
!/reports/painter_distribution_study_v1/*/*.png
