# Local state, credentials and build output
.env
.env.*
!.env.example
*.pem
*.key
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/
tmp/

# Unique local research media, weights and source checkouts stay out of Git.
artifacts/
outputs/
research_workspace/

# Compact evidence is JSON/JSONL under data/manifests; raw bytes stay ignored.
/data/*
!/data/manifests/
/data/manifests/**
!/data/manifests/**/
!/data/manifests/**/*.json
!/data/manifests/**/*.jsonl

# Images and PDFs are excluded except the paper and published numeric plots.
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.webp
!/paper/paper.pdf
!/paper/figures/*.pdf
!/reports/**/plots/*.png
!/reports/painter_distribution_study_v1/*/*.png
# Preserve this terminal raw ledger locally; its portable view is committed.
/data/manifests/painter_capture_audit_v1/pcav1-20260910/attempts.jsonl

# Editorial review transport artifacts remain local; retain compact assessments,
# provenance, validation receipts and the digest inventory in ARCHIVE.md.
/reports/paper_editorial_review_v1/claude_code_review_*/claude_stream.jsonl
/reports/paper_editorial_review_v1/claude_code_review_*/claude_stderr.log
/reports/paper_editorial_review_v1/astra_xhigh_review_*/run_review*.ts
/reports/paper_editorial_review_v1/astra_xhigh_review_*/request*.json
/reports/paper_editorial_review_v1/astra_xhigh_review_*/response_events.jsonl
/reports/paper_editorial_review_v1/astra_xhigh_review_*/completed_response.json
